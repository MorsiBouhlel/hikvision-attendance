{{ form_start(form, {attr: {class: 'form'}}) }}
    <div class="form-row">
        {{ form_label(form.name) }}
        {{ form_widget(form.name, {attr: {class: 'form-control'}}) }}
        {{ form_errors(form.name) }}
    </div>
    <div class="form-row">
        {{ form_label(form.startTime) }}
        {{ form_widget(form.startTime, {attr: {class: 'form-control'}}) }}
        {{ form_errors(form.startTime) }}
    </div>
    <div class="form-row">
        {{ form_label(form.endTime) }}
        {{ form_widget(form.endTime, {attr: {class: 'form-control'}}) }}
        {{ form_errors(form.endTime) }}
        <span class="form-help">{{ 'schedule.midnight_help'|trans }}</span>
    </div>
    <div class="form-row">
        {{ form_label(form.toleranceMinutes) }}
        {{ form_widget(form.toleranceMinutes, {attr: {class: 'form-control'}}) }}
        {{ form_errors(form.toleranceMinutes) }}
    </div>
    <div class="form-row">
        {{ form_label(form.checkWindowMarginMinutes) }}
        {{ form_widget(form.checkWindowMarginMinutes, {attr: {class: 'form-control'}}) }}
        {{ form_errors(form.checkWindowMarginMinutes) }}
        <span class="form-help">{{ 'schedule.margin_help'|trans }}</span>
    </div>
    <div class="form-row">
        <label class="form-label">{{ 'schedule.weekly_plan'|trans }}</label>
        <span class="form-help">{{ 'schedule.weekly_plan_help'|trans }}</span>
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>{{ 'schedule.day'|trans }}</th>
                        <th>{{ 'form.rest_day'|trans }}</th>
                        <th>{{ 'form.start_short'|trans }}</th>
                        <th>{{ 'form.end_short'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for dayOfWeek in 1..7 %}
                        {% set dayForm = attribute(form, 'day' ~ dayOfWeek) %}
                        <tr data-week-plan-row>
                            <td>{{ dayForm.vars.label|trans }}</td>
                            <td>{{ form_widget(dayForm.isRestDay, {attr: {'data-week-plan-rest': ''}}) }}</td>
                            <td>{{ form_widget(dayForm.startTime, {attr: {class: 'form-control', 'data-week-plan-time': ''}}) }}</td>
                            <td>{{ form_widget(dayForm.endTime, {attr: {class: 'form-control', 'data-week-plan-time': ''}}) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% if departments is defined and departments is not empty %}
        <div class="form-row">
            <label class="form-label">{{ 'schedule.assign_by_department'|trans }}</label>
            <div class="checkbox-list" data-department-picker>
                {% for dep in departments %}
                    <label class="checkbox-row">
                        <input type="checkbox" data-department-toggle="{{ dep.id }}">
                        <span>{{ dep.name }} <span class="text-muted">({{ 'employee.count'|trans({'%count%': dep.employees|length}) }})</span></span>
                    </label>
                {% endfor %}
            </div>
            <span class="form-help">{{ 'schedule.department_picker_help'|trans }}</span>
        </div>
    {% endif %}
    <div class="form-row">
        {{ form_label(form.employees) }}
        <div class="checkbox-list checkbox-list--scroll" data-checkbox-search data-checkbox-select-all data-employee-list>
            {% for child in form.employees %}
                {% set emp = employeesById[child.vars.value] %}
                <label class="checkbox-row">
                    {{ form_widget(child, {attr: {'data-department-id': emp.department ? emp.department.id : ''}}) }}
                    <span>
                        {{ emp.fullName }}
                        {% if emp.workSchedule and (schedule is not defined or emp.workSchedule != schedule) %}
                            <span class="text-muted">({{ 'schedule.currently'|trans }}: {{ emp.workSchedule.name }})</span>
                        {% endif %}
                    </span>
                </label>
            {% endfor %}
        </div>
        {{ form_errors(form.employees) }}
    </div>
    <div class="btn-group">
        <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
        <a class="btn" href="{{ path('work_schedule_index') }}">{{ 'common.cancel'|trans }}</a>
    </div>
{{ form_end(form) }}
