{% extends 'emails/layout.html.twig' %}

{% block title %}Votre accès à Softy RH{% endblock %}

{% block content %}
    <p style="margin:0 0 16px; color:#111827; font-size:16px; line-height:1.5;">Bonjour,</p>
    <p style="margin:0 0 16px; color:#374151; font-size:15px; line-height:1.6;">
        Un compte a été créé pour vous sur l'application de gestion de présence, avec l'adresse
        <strong>{{ email }}</strong>.
    </p>
    <p style="margin:0 0 16px; color:#374151; font-size:15px; line-height:1.6;">
        Cliquez sur le bouton ci-dessous pour définir votre mot de passe et accéder à votre compte&nbsp;:
    </p>
    {% include 'emails/_button.html.twig' with {label: 'Définir mon mot de passe', url: link, accent: accent} only %}
    <p style="margin:24px 0 0; color:#9ca3af; font-size:13px; line-height:1.5;">
        Ce lien expire dans 24 heures. Si vous n'êtes pas à l'origine de cette demande, ignorez cet email.
    </p>
{% endblock %}
