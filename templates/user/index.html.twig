{% extends 'base.html.twig' %}

{% block title %}Utilisateurs{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>Utilisateurs</h1>
            <p class="page-header__meta">{{ users|length }} compte(s)</p>
        </div>
        <a class="btn btn--primary" href="{{ path('user_new') }}">+ Nouvel utilisateur</a>
    </div>

    <div class="card">
        {% if users is empty %}
            <div class="table--empty">Aucun utilisateur enregistré.</div>
        {% else %}
            <div class="table-wrap">
                <table class="table" data-table>
                    <thead>
                        <tr>
                            <th data-sort="text">Email</th>
                            <th data-sort="text">Rôle</th>
                            <th data-sort="text">Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            <tr>
                                <td>{{ user.email }}</td>
                                <td>{{ 'ROLE_ADMIN' in user.roles ? 'Administrateur' : 'Lecture seule' }}</td>
                                <td>
                                    {% if user.active %}
                                        <span class="badge badge--present">Actif</span>
                                    {% else %}
                                        <span class="badge badge--inactive">Inactif</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="btn-group">
                                        {% if user is same as(app.user) %}
                                            <span class="badge badge--inactive">Vous</span>
                                        {% else %}
                                            <form method="post" action="{{ path('user_toggle', {id: user.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('user_toggle_' ~ user.id) }}">
                                                <button class="btn btn--sm" type="submit">{{ user.active ? 'Désactiver' : 'Activer' }}</button>
                                            </form>
                                            <form method="post" action="{{ path('user_delete', {id: user.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('user_delete_' ~ user.id) }}">
                                                <button class="btn btn--sm btn--danger" type="submit">Supprimer</button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
