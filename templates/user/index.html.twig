{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.users'|trans }}{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>{{ 'nav.users'|trans }}</h1>
            <p class="page-header__meta">{{ 'user.count'|trans({'%count%': users|length}) }}</p>
        </div>
        <a class="btn btn--primary" href="{{ path('user_new') }}">+ {{ 'user.new'|trans }}</a>
    </div>

    <div class="card">
        {% if users is empty %}
            <div class="table--empty">{{ 'user.none_registered'|trans }}</div>
        {% else %}
            <div class="table-wrap">
                <table class="table" data-table>
                    <thead>
                        <tr>
                            <th data-sort="text">Email</th>
                            <th data-sort="text">{{ 'form.role'|trans }}</th>
                            <th data-sort="text">{{ 'summary.status'|trans }}</th>
                            <th>{{ 'common.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            <tr>
                                <td>{{ user.email }}</td>
                                <td>{{ 'ROLE_ADMIN' in user.roles ? 'role.admin'|trans : 'role.viewer'|trans }}</td>
                                <td>
                                    {% if user.active %}
                                        <span class="badge badge--present">{{ 'common.active'|trans }}</span>
                                    {% else %}
                                        <span class="badge badge--inactive">{{ 'common.inactive'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="btn-group">
                                        {% if user is same as(app.user) %}
                                            <span class="badge badge--inactive">{{ 'user.you'|trans }}</span>
                                        {% else %}
                                            <form method="post" action="{{ path('user_toggle', {id: user.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('user_toggle_' ~ user.id) }}">
                                                <button class="btn btn--sm" type="submit">{{ user.active ? 'telegram.disable'|trans : 'telegram.enable'|trans }}</button>
                                            </form>
                                            <form method="post" action="{{ path('user_delete', {id: user.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('user_delete_' ~ user.id) }}">
                                                <button class="btn btn--sm btn--danger" type="submit">{{ 'common.delete'|trans }}</button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
