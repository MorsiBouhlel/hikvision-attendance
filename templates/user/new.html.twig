{% extends 'base.html.twig' %}

{% block title %}{{ 'user.new'|trans }}{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>{{ 'user.new'|trans }}</h1>
    </div>

    <div class="card">
        <div class="card__body">
            {{ form_start(form, {attr: {class: 'form'}}) }}
                <p class="page-header__meta">{{ 'user.invitation_help'|trans }}</p>
                <div class="form-row">
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.email) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.role) }}
                    {{ form_widget(form.role, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.role) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.employee) }}
                    {{ form_widget(form.employee, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.employee) }}
                    <p class="page-header__meta">{{ 'user.employee_role_help'|trans }}</p>
                </div>
                <div class="btn-group">
                    <button class="btn btn--primary" type="submit">{{ 'user.send_invitation'|trans }}</button>
                    <a class="btn" href="{{ path('user_index') }}">{{ 'common.cancel'|trans }}</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
