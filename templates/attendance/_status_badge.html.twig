{% macro badge(status, lateMinutes) %}
    {% if status == 'late' %}
        <span class="badge badge--warning">En retard{{ lateMinutes ? ' (' ~ lateMinutes ~ ' min)' : '' }}</span>
    {% elseif status == 'on_leave' %}
        <span class="badge badge--inactive">En congé</span>
    {% elseif status == 'holiday' %}
        <span class="badge badge--inactive">Jour férié</span>
    {% elseif status == 'rest_day' %}
        <span class="badge badge--inactive">Repos</span>
    {% elseif status == 'present' %}
        <span class="badge badge--present">Présent</span>
    {% else %}
        <span class="badge badge--absent">Absent</span>
    {% endif %}
{% endmacro %}
