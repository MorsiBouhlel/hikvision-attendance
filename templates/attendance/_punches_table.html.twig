{% set canEdit = employee is defined and employee and is_granted('ROLE_MANAGER') %}
{% if punches is empty %}
    <p class="text-muted">{{ 'punches.none_that_day'|trans }}</p>
{% else %}
    <table class="table table--nested">
        <thead>
            <tr>
                <th>{{ 'punches.time'|trans }}</th>
                <th>{{ 'punches.type'|trans }}</th>
                <th>{{ 'punches.device'|trans }}</th>
                {% if canEdit %}<th></th>{% endif %}
            </tr>
        </thead>
        <tbody>
            {% for punch in punches %}
                <tr>
                    <td>{{ punch.occurredAt|date('H:i:s') }}</td>
                    <td>
                        {% if punch.attendanceStatus == 'checkIn' %}
                            <span class="badge badge--present">{{ 'punches.check_in'|trans }}</span>
                        {% elseif punch.attendanceStatus == 'checkOut' %}
                            <span class="badge badge--inactive">{{ 'punches.check_out'|trans }}</span>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                        {% if punch.eventType == 'manual' %}
                            <span class="badge badge--warning">{{ 'punches.manual'|trans }}</span>
                        {% endif %}
                    </td>
                    <td>{{ punch.device.name }}</td>
                    {% if canEdit %}
                        <td class="btn-group">
                            <a class="btn btn--sm" href="{{ path('employee_punch_edit', {id: employee.id, date: punch.occurredAt|date('Y-m-d'), eventId: punch.id}) }}">{{ icon('pencil', 14) }}{{ 'common.edit'|trans }}</a>
                            <form method="post" action="{{ path('employee_punch_delete', {id: employee.id, date: punch.occurredAt|date('Y-m-d'), eventId: punch.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('punch_delete_' ~ punch.id) }}">
                                <button class="btn btn--sm btn--danger" type="submit">{{ icon('trash', 14) }}{{ 'common.delete'|trans }}</button>
                            </form>
                        </td>
                    {% endif %}
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}
