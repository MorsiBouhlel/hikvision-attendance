{% if punches is empty %}
    <p class="text-muted">{{ 'punches.none_that_day'|trans }}</p>
{% else %}
    <table class="table table--nested">
        <thead>
            <tr>
                <th>{{ 'punches.time'|trans }}</th>
                <th>{{ 'punches.type'|trans }}</th>
                <th>{{ 'punches.device'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for punch in punches %}
                <tr>
                    <td>{{ punch.occurredAt|date('H:i:s') }}</td>
                    <td>
                        {% if punch.attendanceStatus == 'checkIn' %}
                            <span class="badge badge--present">{{ 'punches.check_in'|trans }}</span>
                        {% elseif punch.attendanceStatus == 'checkOut' %}
                            <span class="badge badge--inactive">{{ 'punches.check_out'|trans }}</span>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>{{ punch.device.name }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}
