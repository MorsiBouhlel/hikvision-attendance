{% extends 'base.html.twig' %}

{% block title %}{{ 'device.sync_employees'|trans }}{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>{{ 'device.sync_title'|trans({'%name%': device.name}) }}</h1>
            <p class="page-header__meta">{{ 'device.sync_subtitle'|trans }}</p>
        </div>
    </div>

    <div class="card">
        <div class="card__body">
            {% if unlinked is empty %}
                <p class="text-muted">{{ 'device.no_unlinked_user'|trans }}</p>
                <div class="btn-group" style="margin-top: 16px;">
                    <a class="btn" href="{{ path('device_index') }}">{{ 'common.back'|trans }}</a>
                </div>
            {% else %}
                <form method="post" action="{{ path('device_sync_employees_confirm', {id: device.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('device_sync_' ~ device.id) }}">
                    <div class="checkbox-list">
                        {% for entry in unlinked %}
                            <label class="checkbox-row">
                                <input type="checkbox" name="selected[{{ entry.employeeNo }}]" value="{{ entry.name }}" checked>
                                {% if entry.faceURL %}
                                    <input type="hidden" name="selected_face_url[{{ entry.employeeNo }}]" value="{{ entry.faceURL }}">
                                {% endif %}
                                <span>{{ entry.name }} <span class="text-muted">(employeeNo: {{ entry.employeeNo }})</span></span>
                            </label>
                        {% endfor %}
                    </div>
                    <div class="btn-group" style="margin-top: 20px;">
                        <button class="btn btn--primary" type="submit">{{ 'device.link_selected'|trans }}</button>
                        <a class="btn" href="{{ path('device_index') }}">{{ 'common.cancel'|trans }}</a>
                    </div>
                </form>
            {% endif %}
        </div>
    </div>
{% endblock %}
