{% extends 'base.html.twig' %}
{% import 'attendance/_status_badge.html.twig' as badges %}

{% block title %}{{ employee.fullName }}{% endblock %}

{% block body %}
    <div class="page-header">
        <div style="display: flex; align-items: center; gap: 16px;">
            {% if employee.photoPath %}
                <img class="avatar avatar--lg" src="/uploads/{{ employee.photoPath }}" alt="">
            {% endif %}
            <div>
                <h1>{{ employee.fullName }}</h1>
                <p class="page-header__meta">
                    {{ employee.department.name ?? 'form.no_department'|trans }} ·
                    {% if employee.active %}
                        <span class="badge badge--present">{{ 'common.active'|trans }}</span>
                    {% else %}
                        <span class="badge badge--inactive">{{ 'common.inactive'|trans }}</span>
                    {% endif %}
                </p>
            </div>
        </div>
        <div class="btn-group">
            {% if is_granted('ROLE_ADMIN') %}
                <a class="btn" href="{{ path('employee_edit', {id: employee.id}) }}">{{ 'common.edit'|trans }}</a>
            {% endif %}
            <a class="btn" href="{{ path('employee_index') }}">{{ 'common.back'|trans }}</a>
        </div>
    </div>

    <div class="card">
        <div class="card__header">
            <h2>{{ 'employee.linked_devices'|trans }}</h2>
        </div>
        {% if employee.deviceLinks is empty %}
            <div class="table--empty">{{ 'employee.no_linked_device'|trans }}</div>
        {% else %}
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>{{ 'common.device'|trans }}</th>
                            <th>employeeNo</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for link in employee.deviceLinks %}
                            <tr>
                                <td>{{ link.device.name }}</td>
                                <td>{{ link.employeeNo }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

    <div class="card">
        <div class="card__body">
            <form method="get" class="filter-bar">
                <div class="form-row">
                    <label class="form-label" for="from">{{ 'common.from'|trans }}</label>
                    <input class="form-control" type="date" id="from" name="from" value="{{ start|date('Y-m-d') }}">
                </div>
                <div class="form-row">
                    <label class="form-label" for="to">{{ 'common.to'|trans }}</label>
                    <input class="form-control" type="date" id="to" name="to" value="{{ end|date('Y-m-d') }}">
                </div>
                <button class="btn btn--primary" type="submit">{{ 'common.show'|trans }}</button>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card__header">
            <h2>{{ 'employee.punch_history'|trans }}</h2>
        </div>
        {% if history is empty %}
            <div class="table--empty">{{ 'common.no_data_for_period'|trans }}</div>
        {% else %}
            <div class="table-wrap">
                <table class="table" data-table>
                    <thead>
                        <tr>
                            <th></th>
                            <th data-sort="text">{{ 'summary.date'|trans }}</th>
                            <th data-sort="text">{{ 'summary.status'|trans }}</th>
                            <th data-sort="text">{{ 'summary.check_in'|trans }}</th>
                            <th data-sort="text">{{ 'summary.check_out'|trans }}</th>
                            <th data-sort="number">{{ 'summary.hours'|trans }}</th>
                            <th data-sort="number">{{ 'summary.punches'|trans }}</th>
                            <th data-sort="text">{{ 'summary.overtime'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in history %}
                            {% if row.punches is not empty %}
                                <tr class="row--clickable" data-day-toggle>
                            {% else %}
                                <tr>
                            {% endif %}
                                <td>
                                    {% if row.punches is not empty %}
                                        <span class="js-day-chevron" aria-hidden="true">▸</span>
                                    {% endif %}
                                </td>
                                <td>{{ row.date|date('d/m/Y') }}</td>
                                <td>
                                    {{ badges.badge(row.status, row.late_minutes) }}
                                    {% if row.is_early_leave %}
                                        <span class="badge badge--warning">{{ 'summary.early_leave'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td>{{ row.check_in ?? '—' }}</td>
                                <td>{{ row.check_out ?? '—' }}</td>
                                <td>{{ row.worked_hours is not null ? row.worked_hours ~ ' h' : '—' }}</td>
                                <td>{{ row.events_count }}</td>
                                <td>
                                    {% if row.overtime_in_minutes or row.overtime_out_minutes %}
                                        {% if row.overtime_in_minutes %}<span class="text-muted">+{{ row.overtime_in_minutes }} {{ 'summary.min_check_in'|trans }}</span>{% endif %}
                                        {% if row.overtime_in_minutes and row.overtime_out_minutes %}<br>{% endif %}
                                        {% if row.overtime_out_minutes %}<span class="text-muted">+{{ row.overtime_out_minutes }} {{ 'summary.min_check_out'|trans }}</span>{% endif %}
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>
                            </tr>
                            {% if row.punches is not empty %}
                                <tr data-table-detail hidden>
                                    <td></td>
                                    <td colspan="7">
                                        {% include 'attendance/_punches_table.html.twig' with { punches: row.punches } %}
                                    </td>
                                </tr>
                            {% endif %}
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
