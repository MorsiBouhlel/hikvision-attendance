{% extends 'base.html.twig' %}

{% block title %}{{ (mode == 'new' ? 'punches.correction_new' : 'punches.correction_edit')|trans }}{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>{{ (mode == 'new' ? 'punches.correction_new' : 'punches.correction_edit')|trans }}</h1>
        <p class="page-header__meta">{{ employee.fullName }} — {{ date|date('d/m/Y') }}</p>
    </div>

    <div class="card">
        <div class="card__body">
            {{ form_start(form, {attr: {class: 'form'}}) }}
                <div class="form-row">
                    {{ form_label(form.device) }}
                    {{ form_widget(form.device, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.device) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.occurredAt) }}
                    {{ form_widget(form.occurredAt, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.occurredAt) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.attendanceStatus) }}
                    {{ form_widget(form.attendanceStatus, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.attendanceStatus) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.reason) }}
                    {{ form_widget(form.reason, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.reason) }}
                </div>
                <div class="btn-group">
                    <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
                    <a class="btn" href="{{ path('employee_show', {id: employee.id}) }}">{{ 'common.cancel'|trans }}</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
