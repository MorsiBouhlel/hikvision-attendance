{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.leaves'|trans }}{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>{{ 'nav.leaves'|trans }}</h1>
            <p class="page-header__meta">{{ 'leave.count'|trans({'%count%': leaves|length}) }}</p>
        </div>
        {% if is_granted('ROLE_ADMIN') %}
            <a class="btn btn--primary" href="{{ path('leave_new') }}">+ {{ 'leave.new'|trans }}</a>
        {% endif %}
    </div>

    <div class="card">
        {% if leaves is empty %}
            <div class="table--empty">{{ 'leave.none_registered'|trans }}</div>
        {% else %}
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>{{ 'form.employee'|trans }}</th>
                            <th>{{ 'form.start_short'|trans }}</th>
                            <th>{{ 'form.end_short'|trans }}</th>
                            <th>{{ 'form.type'|trans }}</th>
                            <th>{{ 'form.reason'|trans }}</th>
                            <th>{{ 'common.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for leave in leaves %}
                            <tr>
                                <td>{{ leave.employee.fullName }}</td>
                                <td>{{ leave.startDate|date('d/m/Y') }}</td>
                                <td>{{ leave.endDate|date('d/m/Y') }}</td>
                                <td>{{ ('leave_type.' ~ leave.type)|trans }}</td>
                                <td>{{ leave.reason ?? '—' }}</td>
                                <td>
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <form method="post" action="{{ path('leave_delete', {id: leave.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('leave_delete_' ~ leave.id) }}">
                                            <button class="btn btn--sm btn--danger" type="submit">{{ 'common.delete'|trans }}</button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
