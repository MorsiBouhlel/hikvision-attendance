{% extends 'base.html.twig' %}

{% block title %}{{ 'leave.new'|trans }}{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>{{ 'leave.new'|trans }}</h1>
    </div>

    <div class="card">
        <div class="card__body">
            {{ form_start(form, {attr: {class: 'form'}}) }}
                <div class="form-row">
                    {{ form_label(form.employee) }}
                    {{ form_widget(form.employee, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.employee) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.startDate) }}
                    {{ form_widget(form.startDate, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.startDate) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.endDate) }}
                    {{ form_widget(form.endDate, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.endDate) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.type) }}
                    {{ form_widget(form.type, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.type) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.reason) }}
                    {{ form_widget(form.reason, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.reason) }}
                </div>
                <div class="btn-group">
                    <button class="btn btn--primary" type="submit">{{ 'common.save'|trans }}</button>
                    <a class="btn" href="{{ path('leave_index') }}">{{ 'common.cancel'|trans }}</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
