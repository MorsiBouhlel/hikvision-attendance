{% extends 'base.html.twig' %}
{% import 'leave_request/_status_badge.html.twig' as badges %}

{% block title %}{{ 'nav.remote_work'|trans }}{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>{{ 'nav.remote_work'|trans }}</h1>
        <small>{{ 'remote_work.declarative_note'|trans }}</small>
    </div>

    <div class="card">
        {% if requests is empty %}
            <div class="table--empty">{{ 'remote_work.none'|trans }}</div>
        {% else %}
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>{{ 'form.employee'|trans }}</th>
                            <th>{{ 'form.start_short'|trans }}</th>
                            <th>{{ 'form.end_short'|trans }}</th>
                            <th>{{ 'form.reason'|trans }}</th>
                            <th>{{ 'leave_request.status_label'|trans }}</th>
                            <th>{{ 'common.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for r in requests %}
                            <tr>
                                <td>{{ r.employee.fullName }}</td>
                                <td>{{ r.startDate|date('d/m/Y') }}</td>
                                <td>{{ r.endDate|date('d/m/Y') }}</td>
                                <td>{{ r.reason ?? '—' }}</td>
                                <td>
                                    {{ badges.badge(r.status) }}
                                    {% if exceeds[r.id] ?? false %}<span class="badge badge--warning">{{ 'quota.exceeds'|trans }}</span>{% endif %}
                                    {% if r.decisionComment %}<br><small>{{ r.decisionComment }}</small>{% endif %}
                                </td>
                                <td>
                                    {% if r.pending %}
                                        <form method="post" class="form form--inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('remote_work_decide_' ~ r.id) }}">
                                            <input class="form-control" type="text" name="comment" maxlength="255" placeholder="{{ 'leave_request.comment'|trans }}">
                                            <button class="btn btn--sm btn--primary" type="submit" formaction="{{ path('remote_work_decide', {id: r.id, action: 'approve'}) }}">{{ 'leave_request.approve'|trans }}</button>
                                            <button class="btn btn--sm btn--danger" type="submit" formaction="{{ path('remote_work_decide', {id: r.id, action: 'reject'}) }}">{{ 'leave_request.reject'|trans }}</button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
