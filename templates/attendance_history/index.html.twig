{% extends 'base.html.twig' %}

{% block title %}Historique{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>Historique</h1>
            <p class="page-header__meta">Résumé de présence sur une période</p>
        </div>
    </div>

    <div class="card">
        <div class="card__body">
            <form method="get" class="filter-bar">
                <div class="form-row">
                    <label class="form-label" for="from">Du</label>
                    <input class="form-control" type="date" id="from" name="from" value="{{ from|date('Y-m-d') }}">
                </div>
                <div class="form-row">
                    <label class="form-label" for="to">Au</label>
                    <input class="form-control" type="date" id="to" name="to" value="{{ to|date('Y-m-d') }}">
                </div>
                <div class="form-row">
                    <label class="form-label" for="department">Département</label>
                    <select class="form-control" id="department" name="department">
                        <option value="">Tous les départements</option>
                        {% for dep in departments %}
                            <option value="{{ dep.id }}" {{ dep.id == department ? 'selected' }}>{{ dep.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <button class="btn btn--primary" type="submit">Afficher</button>
            </form>
        </div>
    </div>

    {% for day in days %}
        <div class="card">
            <div class="card__header">
                <h2>Résumé du {{ day.date|date('d/m/Y') }}</h2>
            </div>
            {% include 'attendance/_summary_table.html.twig' with { summary: day.rows } %}
        </div>
    {% else %}
        <div class="card">
            <div class="card__body">
                <p>Aucune donnée pour cette période.</p>
            </div>
        </div>
    {% endfor %}
{% endblock %}
