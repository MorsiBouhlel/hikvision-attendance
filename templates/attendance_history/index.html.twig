{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.history'|trans }}{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>{{ 'nav.history'|trans }}</h1>
            <p class="page-header__meta">{{ 'history.subtitle'|trans }}</p>
        </div>
    </div>

    <div class="card">
        <div class="card__body">
            <form method="get" class="filter-bar">
                <div class="form-row">
                    <label class="form-label" for="from">{{ 'common.from'|trans }}</label>
                    <input class="form-control" type="date" id="from" name="from" value="{{ from|date('Y-m-d') }}">
                </div>
                <div class="form-row">
                    <label class="form-label" for="to">{{ 'common.to'|trans }}</label>
                    <input class="form-control" type="date" id="to" name="to" value="{{ to|date('Y-m-d') }}">
                </div>
                <div class="form-row">
                    <label class="form-label" for="department">{{ 'form.department'|trans }}</label>
                    <select class="form-control" id="department" name="department">
                        <option value="">{{ 'common.all_departments'|trans }}</option>
                        {% for dep in departments %}
                            <option value="{{ dep.id }}" {{ dep.id == department ? 'selected' }}>{{ dep.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <button class="btn btn--primary" type="submit">{{ 'common.show'|trans }}</button>
            </form>
        </div>
    </div>

    <div data-history-search>
        {% for day in days %}
            <div class="card" data-history-day>
                <div class="card__header">
                    <h2>{{ 'history.day_summary'|trans({'%date%': day.date|date('d/m/Y')}) }}</h2>
                </div>
                {% include 'attendance/_summary_table.html.twig' with { summary: day.rows, searchExternal: true } %}
            </div>
        {% else %}
            <div class="card">
                <div class="card__body">
                    <p>{{ 'history.no_data_for_period'|trans }}</p>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
