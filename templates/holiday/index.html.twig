{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.holidays'|trans }}{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>{{ 'nav.holidays'|trans }}</h1>
            <p class="page-header__meta">{{ 'holiday.count'|trans({'%count%': holidays|length}) }}</p>
        </div>
        {% if is_granted('ROLE_ADMIN') %}
            <a class="btn btn--primary" href="{{ path('holiday_new') }}">+ {{ 'holiday.new'|trans }}</a>
        {% endif %}
    </div>

    <div class="card">
        {% if holidays is empty %}
            <div class="table--empty">{{ 'holiday.none_registered'|trans }}</div>
        {% else %}
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>{{ 'form.date'|trans }}</th>
                            <th>{{ 'form.label'|trans }}</th>
                            <th>{{ 'common.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for holiday in holidays %}
                            <tr>
                                <td>{{ holiday.date|date('d/m/Y') }}</td>
                                <td>{{ holiday.label }}</td>
                                <td>
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <form method="post" action="{{ path('holiday_delete', {id: holiday.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('holiday_delete_' ~ holiday.id) }}">
                                            <button class="btn btn--sm btn--danger" type="submit">{{ 'common.delete'|trans }}</button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
