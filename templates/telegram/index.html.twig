{% extends 'base.html.twig' %}

{% block title %}Telegram{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>{{ 'telegram.title'|trans }}</h1>
            <p class="page-header__meta">{{ 'telegram.subtitle'|trans }}</p>
        </div>
    </div>

    <div class="card">
        <div class="card__header">
            <h2>{{ 'telegram.status'|trans }}</h2>
        </div>
        <div class="card__body">
            <div class="btn-group" style="align-items: center;">
                {% if enabled %}
                    <span class="badge badge--present">{{ 'flash.alerts_enabled'|trans }}</span>
                {% else %}
                    <span class="badge badge--inactive">{{ 'flash.alerts_disabled'|trans }}</span>
                {% endif %}
                <form method="post" action="{{ path('telegram_toggle_alerts') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('telegram_toggle_alerts') }}">
                    <button class="btn btn--sm" type="submit">{{ enabled ? 'telegram.disable'|trans : 'telegram.enable'|trans }}</button>
                </form>
                <form method="post" action="{{ path('telegram_test') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('telegram_test') }}">
                    <button class="btn btn--sm btn--primary" type="submit">{{ 'telegram.send_test'|trans }}</button>
                </form>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card__header">
            <h2>{{ 'telegram.add_recipient'|trans }}</h2>
        </div>
        <div class="card__body">
            {{ form_start(form, {action: path('telegram_new'), method: 'post', attr: {class: 'form'}}) }}
                <div class="form-row">
                    {{ form_label(form.label) }}
                    {{ form_widget(form.label, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.label) }}
                </div>
                <div class="form-row">
                    {{ form_label(form.chatId) }}
                    {{ form_widget(form.chatId, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(form.chatId) }}
                    <span class="form-help">{{ 'telegram.chat_id_help'|trans|raw }}</span>
                </div>
                <div class="btn-group">
                    <button class="btn btn--primary" type="submit">{{ 'telegram.add'|trans }}</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>

    <div class="card">
        <div class="card__header">
            <h2>{{ 'telegram.recipients'|trans }}</h2>
        </div>
        {% if recipients is empty %}
            <div class="table--empty">{{ 'telegram.none_registered'|trans }}</div>
        {% else %}
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>{{ 'form.name'|trans }}</th>
                            <th>Chat ID</th>
                            <th>{{ 'summary.status'|trans }}</th>
                            <th>{{ 'common.actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for recipient in recipients %}
                            <tr>
                                <td>{{ recipient.label }}</td>
                                <td>{{ recipient.chatId }}</td>
                                <td>
                                    {% if recipient.active %}
                                        <span class="badge badge--present">{{ 'common.active'|trans }}</span>
                                    {% else %}
                                        <span class="badge badge--inactive">{{ 'common.inactive'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <form method="post" action="{{ path('telegram_toggle', {id: recipient.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('telegram_toggle_' ~ recipient.id) }}">
                                            <button class="btn btn--sm" type="submit">{{ recipient.active ? 'telegram.disable'|trans : 'telegram.enable'|trans }}</button>
                                        </form>
                                        <form method="post" action="{{ path('telegram_delete', {id: recipient.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('telegram_delete_' ~ recipient.id) }}">
                                            <button class="btn btn--sm btn--danger" type="submit">{{ 'common.delete'|trans }}</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
