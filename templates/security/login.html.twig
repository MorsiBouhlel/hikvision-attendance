<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Connexion — Hikvision Attendance</title>
    {{ importmap('app') }}
</head>
<body>
    <div class="login-page">
        <div class="card login-card">
            <div class="card__header">
                <h1>Présence</h1>
                <p class="page-header__meta">Hikvision Attendance</p>
            </div>
            <div class="card__body">
                {% if error %}
                    <div class="flash flash--error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                <form method="post" class="form">
                    <div class="form-row">
                        <label for="username">Email</label>
                        <input type="email" id="username" name="_username" value="{{ last_username }}" class="form-control" required autofocus>
                    </div>
                    <div class="form-row">
                        <label for="password">Mot de passe</label>
                        <input type="password" id="password" name="_password" class="form-control" required>
                    </div>
                    <div class="btn-group">
                        <button class="btn btn--primary" type="submit">Se connecter</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
