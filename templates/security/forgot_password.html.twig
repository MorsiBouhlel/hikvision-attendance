<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'user.forgot_password'|trans }} — Softy RH</title>
    {{ importmap('app') }}
</head>
<body>
    <div class="login-page">
        <div class="card login-card">
            <div class="card__header">
                <h1>Softy RH</h1>
                <p class="page-header__meta">{{ 'user.forgot_password'|trans }}</p>
            </div>
            <div class="card__body">
                {% for message in app.flashes('error') %}
                    <div class="flash flash--error">{{ message.key|trans }}</div>
                {% endfor %}
                <p>{{ 'user.forgot_password_help'|trans }}</p>
                <form method="post" class="form">
                    <input type="hidden" name="_token" value="{{ csrf_token('forgot_password') }}">
                    <div class="form-row">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" class="form-control" required autofocus>
                    </div>
                    <div class="btn-group">
                        <button class="btn btn--primary" type="submit">{{ 'user.send_reset_link'|trans }}</button>
                        <a class="btn" href="{{ path('app_login') }}">{{ 'common.back'|trans }}</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
